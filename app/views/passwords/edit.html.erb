<% content_for :title, "Skift adgangskode" %>

<h1>Skift adgangskode</h1>

<%= form_with model: @user, url: password_path, method: :patch do |form| %>
  <%= render "shared/errors", record: @user %>

  <div class="field">
    <%= form.label :password_challenge, "Nuværende adgangskode" %>
    <%= form.password_field :password_challenge, required: true, autofocus: true, autocomplete: "current-password", maxlength: 72 %>
  </div>
  <div class="field">
    <%= form.label :password, "Ny adgangskode" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    <span class="hint">Mindst <%= User::PASSWORD_MINIMUM_LENGTH %> tegn.</span>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "Gentag ny adgangskode" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <%= form.submit "Skift adgangskode" %>
<% end %>

<%= back_link "Tilbage til spillet", spil_path %>
