<% content_for :title, "Venner" %>

<h1>Venner</h1>

<section>
  <h2>Find spillere</h2>
  <%= form_with url: friendships_path, method: :get do |form| %>
    <div class="field">
      <%= form.label :q, "Brugernavn" %>
      <%= form.search_field :q, value: @query, autocomplete: "off" %>
    </div>
    <%= form.submit "Søg", name: nil %>
  <% end %>

  <% if @query.present? %>
    <% if @search_results.any? %>
      <ul class="people" id="search-results">
        <% @search_results.each do |user| %>
          <li>
            <span class="name"><%= user.username %></span>
            <%= button_to "Send venneanmodning", friendships_path, params: { addressee_id: user.id } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="hint">Ingen spillere matcher “<%= @query %>”.</p>
    <% end %>
  <% end %>
</section>

<% if @incoming.any? %>
  <section>
    <h2>Venneanmodninger til dig</h2>
    <ul class="people" id="incoming-requests">
      <% @incoming.each do |friendship| %>
        <li>
          <span class="name"><%= friendship.requester.username %></span>
          <%= button_to "Accepter", friendship_path(friendship), method: :patch %>
          <%= button_to "Afvis", friendship_path(friendship), method: :delete %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<% if @outgoing.any? %>
  <section>
    <h2>Sendte anmodninger</h2>
    <ul class="people" id="outgoing-requests">
      <% @outgoing.each do |friendship| %>
        <li>
          <span class="name"><%= friendship.addressee.username %></span>
          <span class="hint">Afventer svar</span>
          <%= button_to "Træk tilbage", friendship_path(friendship), method: :delete %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section>
  <h2>Dine venner</h2>
  <% if @friendships.any? %>
    <ul class="people" id="friends">
      <% @friendships.each do |friendship| %>
        <% friend = friendship.other_user(Current.user) %>
        <li>
          <%= tag.span class: [ "presence", { online: friend.online? } ] %>
          <span class="name"><%= friend.username %></span>
          <span class="hint"><%= friend.online? ? "Online" : "Offline" %></span>
          <%= button_to "Fjern", friendship_path(friendship), method: :delete %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="hint">Du har ingen venner endnu. Søg efter en spiller ovenfor.</p>
  <% end %>
</section>
