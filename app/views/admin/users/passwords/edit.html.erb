<% content_for :title, "Ny adgangskode til #{@user.username}" %>
<% content_for :page_class, "page-wide" %>

<header class="page-header">
  <h1>Admin</h1>
  <p class="lead">Godkend nye spillere og hold styr på brugerne.</p>
</header>
<%= render "admin/nav" %>

<section class="panel panel-narrow" aria-labelledby="password-heading">
  <h2 id="password-heading">Ny adgangskode til <%= @user.username %></h2>
  <p class="hint">Skriv den nye adgangskode og giv den til <%= @user.username %>. Brugeren bliver logget ud alle steder og kan selv skifte den bagefter.</p>

  <%= form_with model: @user, url: admin_user_password_path(@user), method: :patch do |form| %>
    <%= render "shared/errors", record: @user %>

    <div class="field">
      <%= form.label :password, "Ny adgangskode" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, aria: { describedby: "password-hint" } %>
      <span class="hint" id="password-hint">Mindst <%= User::PASSWORD_MINIMUM_LENGTH %> tegn.</span>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Gentag ny adgangskode" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div class="form-actions">
      <%= form.submit "Sæt ny adgangskode", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>

<%= back_link "Tilbage til Alle brugere", admin_users_path %>
