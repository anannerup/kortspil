<% content_for :title, "Ny adgangskode til #{@user.username}" %>

<h1>Ny adgangskode til <%= @user.username %></h1>
<%= render "admin/nav" %>

<p>Skriv den nye adgangskode og giv den til <%= @user.username %>. Brugeren bliver logget ud alle steder og kan selv skifte den bagefter.</p>

<%= form_with model: @user, url: admin_user_password_path(@user), method: :patch do |form| %>
  <%= render "shared/errors", record: @user %>

  <div class="field">
    <%= form.label :password, "Ny adgangskode" %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72 %>
    <span class="hint">Mindst <%= User::PASSWORD_MINIMUM_LENGTH %> tegn.</span>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "Gentag ny adgangskode" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <%= form.submit "Sæt ny adgangskode" %>
<% end %>

<%= back_link "Tilbage til Alle brugere", admin_users_path %>
