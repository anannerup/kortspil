<%# Buttons for one user, depending on their approval state. %>
<div class="actions">
  <% if user == Current.user %>
    <span class="hint">Det er dig</span>
  <% else %>
    <% case user.approval_state %>
    <% when "pending", "rejected" %>
      <%= button_to "Godkend", admin_user_approval_path(user) %>
      <%= button_to "Afvis", admin_user_rejection_path(user) if user.pending? %>
    <% when "approved" %>
      <%= button_to "Fjern godkendelse", admin_user_approval_path(user), method: :delete %>
      <%= button_to "Bloker", admin_user_block_path(user) %>
    <% when "blocked" %>
      <%= button_to "Ophæv blokering", admin_user_block_path(user), method: :delete %>
    <% end %>
    <% unless user.pending? %>
      <%= link_to "Sæt ny adgangskode", edit_admin_user_password_path(user) %>
    <% end %>
  <% end %>
</div>
