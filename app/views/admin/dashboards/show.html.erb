<% content_for :title, "Admin" %>
<% content_for :page_class, "page-wide" %>

<header class="page-header">
  <h1>Admin</h1>
  <p class="lead">Godkend nye spillere og hold styr på brugerne.</p>
</header>
<%= render "admin/nav" %>

<section class="panel" aria-labelledby="pending-heading">
  <div class="panel-header">
    <h2 id="pending-heading">Afventer godkendelse</h2>
    <%= tag.span(@pending_users.size, class: "pill pill-amber") if @pending_users.any? %>
  </div>
  <% if @pending_users.any? %>
    <ul class="list">
      <%= render partial: "admin/users/user", collection: @pending_users, locals: { show_status: false, show_created: true } %>
    </ul>
  <% else %>
    <p class="empty">Ingen afventer godkendelse lige nu.</p>
  <% end %>
</section>

<% if @reset_requests.any? %>
  <section class="panel" aria-labelledby="resets-heading">
    <div class="panel-header">
      <h2 id="resets-heading">Har glemt adgangskoden</h2>
      <%= tag.span(@reset_requests.size, class: "pill pill-amber") %>
    </div>
    <ul class="list">
      <% @reset_requests.each do |user| %>
        <li class="list-item" id="<%= dom_id(user, :reset) %>">
          <div class="list-main">
            <%= user_avatar(user) %>
            <div class="list-text">
              <div class="list-title"><%= user.username %></div>
              <div class="list-meta"><%= user.email_address %> · bad om det <%= user.password_reset_requested_at.strftime("%-d/%-m %Y %H:%M") %></div>
            </div>
          </div>
          <div class="list-actions">
            <%= link_to "Sæt ny adgangskode", edit_admin_user_password_path(user), class: "btn btn-primary" %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="panel" aria-labelledby="tables-heading">
  <div class="panel-header">
    <h2 id="tables-heading">Aktive borde</h2>
    <%= tag.span(@active_tables.size, class: "pill") if @active_tables.any? %>
  </div>
  <% if @active_tables.any? %>
    <ul class="list">
      <% @active_tables.each do |table| %>
        <li id="<%= dom_id(table) %>" class="list-item">
          <div class="list-main">
            <div class="list-text">
              <div class="list-title">
                <%= table.name %>
                <span class="pill"><%= t("tables.kinds.#{table.kind}") %></span>
                <span class="pill <%= table.playing? ? "pill-green" : "pill-amber" %>"><%= t("tables.statuses.#{table.status}") %></span>
              </div>
              <div class="list-meta">
                Vært <span class="host"><%= table.host.username %></span> ·
                <span class="players"><%= table.seating.occupants.map { |occupant| occupant.name || "–" }.join(", ") %></span> ·
                <%= table.created_at.strftime("%-d/%-m %Y %H:%M") %>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty">Ingen aktive borde lige nu.</p>
  <% end %>
</section>
