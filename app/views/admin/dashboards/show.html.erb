<% content_for :title, "Admin" %>
<% content_for :page_class, "page-wide" %>

<h1>Admin</h1>
<%= render "admin/nav" %>

<h2>Afventer godkendelse</h2>
<% if @pending_users.any? %>
  <table class="admin-table">
    <thead>
      <tr><th>Brugernavn</th><th>E-mail</th><th>Oprettet</th><th></th></tr>
    </thead>
    <tbody>
      <% @pending_users.each do |user| %>
        <tr id="<%= dom_id(user) %>">
          <td><%= user.username %></td>
          <td><%= user.email_address %></td>
          <td><%= user.created_at.strftime("%-d/%-m %Y") %></td>
          <td><%= render "admin/users/actions", user: user %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Ingen afventer godkendelse.</p>
<% end %>

<h2>Aktive borde</h2>
<% if @active_tables.any? %>
  <table class="admin-table">
    <thead>
      <tr><th>Bord</th><th>Type</th><th>Vært</th><th>Spillere</th><th>Status</th><th>Oprettet</th></tr>
    </thead>
    <tbody>
      <% @active_tables.each do |table| %>
        <tr id="<%= dom_id(table) %>">
          <td><%= table.id %></td>
          <td><%= t("tables.kinds.#{table.kind}") %></td>
          <td><%= table.host.username %></td>
          <td><%= table.seating.occupants.map { |occupant| occupant.name || "–" }.join(", ") %></td>
          <td><%= t("tables.statuses.#{table.status}") %></td>
          <td><%= table.created_at.strftime("%-d/%-m %Y %H:%M") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Ingen aktive borde.</p>
<% end %>
