<!DOCTYPE html>
<html lang="da">
  <head>
    <title><%= content_for(:title) || "Kortspil" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kortspil">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag "application.tsx" %>

  </head>

  <body>
    <% if authenticated? && Current.user.approved? %>
      <nav class="account-nav">
        <span><%= Current.user.username %></span>
        <%= link_to "Admin", admin_root_path if Current.user.admin? %>
        <%= link_to friendships_path do %>Venner<% if (count = Current.user.received_friendships.pending.count).positive? %> <span class="badge" title="Venneanmodninger"><%= count %></span><% end %><% end %>
        <%= link_to "Skift adgangskode", edit_password_path %>
        <%= button_to "Log ud", session_path, method: :delete %>
      </nav>
    <% end %>

    <main class="page <%= yield :page_class %>">
      <%= tag.p(flash[:alert], class: "flash flash-alert") if flash[:alert] %>
      <%= tag.p(flash[:notice], class: "flash flash-notice") if flash[:notice] %>
      <%= yield %>
    </main>
  </body>
</html>
